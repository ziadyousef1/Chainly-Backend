{
  "ConnectionStrings": {
    "DefaultConnection": "Server=SHAHD;Initial Catalog=ChainlyDB;Integrated Security=True;Pooling=False;Encrypt=False;Trust Server Certificate=True",
    "ProductionConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/chainly-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Jwt": {
    "Key": "",
    "Issuer": "https://localhost",
    "Audience": "https://localhost:44317",
    "DurationInDays": 30
  },
  "EmailConfiguration": {
    "From": "",
    "SmtpServer": "smtp.gmail.com",
    "Port": 465,
    "UserName": "",
    "Password": "",
    "DisplayName": "Hello from Chainly :)"
  },
  "AzureOpenAISettings": {
    "Endpoint": "",
    "ApiKey": "",
    "DeploymentName": "gpt-4.1",
    "ApiVersion": "2025-04-14"
  },
  "AiApi": {
    "BaseUrl": "http://20.51.117.96:8000"
  }
}
